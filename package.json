{
  "name": "reactbitsprocomponents",
  "version": "1.0.0",
  "private": true,
  "description": "Коллекция самостоятельно воссозданных анимированных React-компонентов",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "components/*"
  ],
  "scripts": {
    "dev": "npm run dev:ember",
    "dev:cloud": "npm run dev --workspace=cloud-atlas",
    "dev:tide": "npm run dev --workspace=glyph-tide",
    "dev:ember": "npm run dev --workspace=glyph-ember",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "start": "npm run start --workspace=glyph-ember"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/morokaze/reactbitsprocomponents.git"
  }
}
